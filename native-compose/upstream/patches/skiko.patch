+    if (instance->getPosTan(distance, nullptr, &tangent)) {
+        data[0] = tangent.fX;
+        data[1] = tangent.fY;
+        return true;
+    }
+
+    return false;
+}
+
+SKIKO_EXPORT KBoolean org_jetbrains_skia_PathMeasure__1nGetRSXform
+  (KNativePointer ptr, KFloat distance, KFloat* data) {
