+    SkVector tangent;
+    if (instance->getPosTan(distance, &position, &tangent)) {
+        data[0] = tangent.fX;
+        data[1] = tangent.fY;
+        data[2] = position.fX;
+        data[3] = position.fY;
+        return true;
+    }
+
