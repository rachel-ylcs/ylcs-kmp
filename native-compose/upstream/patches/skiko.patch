+
+internal actual fun Drawable.doInit(ptr: NativePointer) {
+    Stats.onNativeCall()
+    interopScope {
+        val onDrawCallback = virtual {
+            onDraw(Canvas(_nGetOnDrawCanvas(_ptr), false, this))
+        }
+        val onGetBoundsCallback = virtual {
