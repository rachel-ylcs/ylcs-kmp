+namespace skija {
+    namespace Rect {
+        void copyToInterop(const SkRect& rect, KInteropPointer pointer) {
+            float* ltrb = reinterpret_cast<float*>(pointer);
+            if (ltrb != nullptr) {
+                ltrb[0] = rect.left();
