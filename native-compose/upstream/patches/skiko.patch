+  SkBitmap* dst = reinterpret_cast<SkBitmap*>(dstPtr);
+  SkPaint* paint = reinterpret_cast<SkPaint*>(paintPtr);
+  SkIPoint offset;
+
+  if (instance->extractAlpha(dst, paint, &offset)) {
+      result[0] = offset.fX;
+      result[1] = offset.fY;
+      return true;
+  } else {
+     return false;
