+        }
+
+        void copyToInterop(const std::vector<SkCodec::FrameInfo>& infos, KInteropPointer dst) {
+            KInt* repr = reinterpret_cast<KInt*>(dst);
+            size_t i = 0;
+            for (const auto& info : infos) {
+                copyToInteropAtIndex(info, repr, i++);
+            }
+        }
