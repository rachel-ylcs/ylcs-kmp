+private inline fun withExternalWindow(block: (Long) -> Unit) {
+    val hwnd =
+        checkNotNull(
+            CreateWindowExW(
+                0u,
+                "STATIC",
+                "Skiko external HWND test",
+                WS_OVERLAPPEDWINDOW.toUInt(),
+                CW_USEDEFAULT,
+                CW_USEDEFAULT,
+                96,
+                64,
+                null,
+                null,
+                GetModuleHandleW(null),
+                null,
+            ),
+        )
+    try {
+        block(hwnd.rawValue.toLong())
+    } finally {
+        DestroyWindow(hwnd)
+    }
+}
