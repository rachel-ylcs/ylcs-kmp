+SKIKO_EXPORT KFloat org_jetbrains_skia_Font__1nGetSpacing
+  (KNativePointer ptr) {
+    SkFont* instance = reinterpret_cast<SkFont*>(ptr);
+    return instance->getSpacing();
+}
