+/* Rachel: negotiate the format and hit target before advertising COPY to OLE. */
+static Uint32 WIN_RachelDropTypes(SDLDropTarget *target, IDataObject *data)
+{
+    const CLIPFORMAT formats[] = {CF_HDROP, (CLIPFORMAT)target->format_file,
+        CF_UNICODETEXT, CF_TEXT, (CLIPFORMAT)target->format_text};
+    Uint32 types = 0;
+    for (int i = 0; i < 5; ++i) {
+        FORMATETC format = {formats[i], NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL};
+        if (data->lpVtbl->QueryGetData(data, &format) == S_OK) {
+            types |= i < 2 ? RACHEL_SDL_DROP_FILE : RACHEL_SDL_DROP_TEXT;
+        }
+    }
+    return types;
+}
+
+static DWORD WIN_RachelDropEffect(SDLDropTarget *target, DWORD effects, POINTL pt, Uint32 types)
+{
+    POINT point = {pt.x, pt.y};
+    if (!ScreenToClient(target->hwnd, &point)) return DROPEFFECT_NONE;
+    SDL_SendDropPosition(target->window, point.x, point.y);
+    Uint32 accepted = RachelSDL_QueryDrop(target->window, types, (float)point.x, (float)point.y);
+    return accepted && (effects & DROPEFFECT_COPY) ? DROPEFFECT_COPY : DROPEFFECT_NONE;
+}
