+/* Rachel: negotiate without reading the offered data before the user drops it. */
+static void Wayland_RachelDropTarget(SDL_WaylandDataDevice *device, float x, float y)
+{
+    const char *file = NULL, *text = NULL;
+#ifdef SDL_USE_LIBDBUS
+    if (Wayland_data_offer_has_mime(device->drag_offer, FILE_PORTAL_MIME)) file = FILE_PORTAL_MIME;
+#endif
+    if (Wayland_data_offer_has_mime(device->drag_offer, FILE_MIME)) file = FILE_MIME;
+    size_t count = 0;
+    const char *const *mimes = Wayland_GetTextMimeTypes(SDL_GetVideoDevice(), &count);
+    for (size_t i = 0; i < count; ++i) {
+        if (Wayland_data_offer_has_mime(device->drag_offer, mimes[i])) {
+            text = mimes[i];
+            break;
+        }
+    }
+    Uint32 types = (file ? RACHEL_SDL_DROP_FILE : 0) | (text ? RACHEL_SDL_DROP_TEXT : 0);
+    Uint32 accepted = RachelSDL_QueryDrop(device->dnd_window, types, x, y);
+    device->has_mime_file = accepted == RACHEL_SDL_DROP_FILE;
+    device->has_mime_text = accepted == RACHEL_SDL_DROP_TEXT;
+    device->mime_type = device->has_mime_file ? file : device->has_mime_text ? text : NULL;
