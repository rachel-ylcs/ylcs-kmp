+
+/* Rachel: retain both advertised formats so hit testing can choose the matching one. */
+static void X11_RachelDropTargets(SDL_Window *window, Display *display, Atom *atoms, int count)
+{
+    Atom file = None, text = None;
+    for (int i = 0; i < count; ++i) {
+        if (atoms[i] == None) continue;
+        char *name = X11_XGetAtomName(display, atoms[i]);
+        if (!name) continue;
+        if (SDL_strcmp(name, "text/uri-list") == 0) file = atoms[i];
+        else if (SDL_strcmp(name, "text/plain;charset=utf-8") == 0 || SDL_strcmp(name, "UTF8_STRING") == 0) text = atoms[i];
+        else if (text == None && (SDL_strcmp(name, "text/plain") == 0 || SDL_strcmp(name, "TEXT") == 0)) text = atoms[i];
+        X11_XFree(name);
+    }
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    SDL_SetNumberProperty(props, "rachel.drop.x11.file", (Sint64)file);
+    SDL_SetNumberProperty(props, "rachel.drop.x11.text", (Sint64)text);
+}
+
+static Atom X11_RachelDropTarget(SDL_Window *window, float x, float y)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    Atom file = (Atom)SDL_GetNumberProperty(props, "rachel.drop.x11.file", None);
+    Atom text = (Atom)SDL_GetNumberProperty(props, "rachel.drop.x11.text", None);
