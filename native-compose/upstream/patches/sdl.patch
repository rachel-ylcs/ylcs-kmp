+/* Rachel extension: whole-window mouse passthrough. */
+#include "SDL_internal.h"
+#if defined(SDL_VIDEO_DRIVER_WINDOWS) && !defined(SDL_PLATFORM_XBOXONE) && !defined(SDL_PLATFORM_XBOXSERIES)
+#include "SDL_windowsvideo.h"
+
+bool WIN_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+bool WIN_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled)
+{
+    HWND hwnd = window->internal->hwnd;
+    if (enabled && (GetClassLongPtrW(hwnd, GCL_STYLE) & (CS_OWNDC | CS_CLASSDC))) {
+        return SDL_SetError("Mouse passthrough requires a window class without CS_OWNDC or CS_CLASSDC");
+    }
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    const LONG_PTR mask = WS_EX_LAYERED | WS_EX_TRANSPARENT;
+    const LONG_PTR style = GetWindowLongPtrW(hwnd, GWL_EXSTYLE);
+    const LONG_PTR original = enabled ? (style & mask) : (LONG_PTR)SDL_GetNumberProperty(props, "rachel.window.mouse.original_style", 0);
+    if (enabled && !SDL_SetNumberProperty(props, "rachel.window.mouse.original_style", (Sint64)original)) return false;
+    const LONG_PTR next = enabled ? (style | mask) : ((style & ~mask) | original);
+    SetLastError(0);
+    if (!SetWindowLongPtrW(hwnd, GWL_EXSTYLE, next) && GetLastError()) return WIN_SetError("SetWindowLongPtrW");
+    if (enabled && !(style & WS_EX_LAYERED) && !SetLayeredWindowAttributes(hwnd, 0, 255, LWA_ALPHA)) {
+        DWORD error = GetLastError();
+        SetWindowLongPtrW(hwnd, GWL_EXSTYLE, style);
+        SetLastError(error);
+        return WIN_SetError("SetLayeredWindowAttributes");
+    }
+    if (!SetWindowPos(hwnd, NULL, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOSIZE | SWP_NOMOVE | SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE)) {
+        DWORD error = GetLastError();
+        SetWindowLongPtrW(hwnd, GWL_EXSTYLE, style);
+        SetLastError(error);
+        return WIN_SetError("SetWindowPos");
+    }
+    return true;
+}
+#endif
