new file mode 100644
--- /dev/null
+++ b/include/SDL3/SDL_racheldrop.h
@@ -0,0 +1,58 @@
+/* Rachel extension: synchronous, per-window drop negotiation. Not an upstream SDL API. */
+#ifndef SDL_racheldrop_h_
+#define SDL_racheldrop_h_
+#include "SDL_video.h"
+#include "SDL_properties.h"
+
+#define RACHEL_SDL_DROP_FILE 1u
+#define RACHEL_SDL_DROP_TEXT 2u
+typedef Uint32 (SDLCALL *RachelSDL_DropCallback)(void *userdata, Uint32 types, float x, float y);
+
+static inline bool RachelSDL_SetDropCallback(void *window, RachelSDL_DropCallback callback, void *userdata)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties((SDL_Window *)window);
+    if (!callback) {
+        SDL_ClearProperty(props, "rachel.drop.callback");
+        SDL_ClearProperty(props, "rachel.drop.userdata");
+        return true;
+    }
+    return SDL_SetPointerProperty(props, "rachel.drop.userdata", userdata) &&
+        SDL_SetPointerProperty(props, "rachel.drop.callback", (void *)callback);
+}
+
+static inline Uint32 RachelSDL_QueryDrop(SDL_Window *window, Uint32 types, float x, float y)
+{
+    if (!window) return 0;
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    RachelSDL_DropCallback callback = (RachelSDL_DropCallback)SDL_GetPointerProperty(props, "rachel.drop.callback", NULL);
+    Uint32 accepted = callback ? callback(SDL_GetPointerProperty(props, "rachel.drop.userdata", NULL), types, x, y) & types : 0;
+    SDL_SetNumberProperty(props, "rachel.drop.types", types);
+    SDL_SetNumberProperty(props, "rachel.drop.accepted", accepted);
+    SDL_SetFloatProperty(props, "rachel.drop.x", x);
+    SDL_SetFloatProperty(props, "rachel.drop.y", y);
+    return accepted;
+}
+
+static inline Uint32 RachelSDL_DropTypes(SDL_Window *window)
+{
+    return (Uint32)SDL_GetNumberProperty(SDL_GetWindowProperties(window), "rachel.drop.types", 0);
+}
+
+static inline Uint32 RachelSDL_AcceptedDrop(SDL_Window *window)
+{
+    return (Uint32)SDL_GetNumberProperty(SDL_GetWindowProperties(window), "rachel.drop.accepted", 0);
+}
+
+static inline Uint32 RachelSDL_RecheckDrop(SDL_Window *window)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    return RachelSDL_QueryDrop(window, RachelSDL_DropTypes(window),
+        SDL_GetFloatProperty(props, "rachel.drop.x", 0), SDL_GetFloatProperty(props, "rachel.drop.y", 0));
+}
+
+static inline void RachelSDL_EndDrop(SDL_Window *window)
+{
+    if (!window) return;
+    RachelSDL_QueryDrop(window, 0, 0, 0);
+}
+#endif
