+/* Rachel extension: whole-window mouse passthrough. */
+#include "SDL_internal.h"
+#ifdef SDL_VIDEO_DRIVER_WAYLAND
+#include "SDL_waylandvideo.h"
+#include "SDL_waylandwindow.h"
+
+bool Wayland_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+bool Wayland_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled)
+{
+    SDL_VideoData *video = _this->internal;
+    SDL_WindowData *data = window->internal;
+    struct wl_region *region = NULL;
+    if (enabled) {
+        region = wl_compositor_create_region(video->compositor);
+        if (!region) return SDL_OutOfMemory();
+    }
+    wl_surface_set_input_region(data->surface, region);
+    if (region) wl_region_destroy(region);
+    wl_surface_commit(data->surface);
+    WAYLAND_wl_display_flush(video->display);
+    return true;
+}
+#endif
