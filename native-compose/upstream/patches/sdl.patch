+#ifdef SDL_VIDEO_DRIVER_WINDOWS
+extern bool WIN_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+#endif
+#ifdef SDL_VIDEO_DRIVER_COCOA
+extern bool Cocoa_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+#endif
+#ifdef SDL_VIDEO_DRIVER_X11
+extern bool X11_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+#endif
+#ifdef SDL_VIDEO_DRIVER_WAYLAND
+extern bool Wayland_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+#endif
+
+bool SDLCALL RachelSDL_SetWindowMousePassthrough(SDL_Window *window, bool enabled)
+{
+    CHECK_WINDOW_MAGIC(window, false);
+    if (enabled && !(window->flags & SDL_WINDOW_BORDERLESS)) {
+        return SDL_SetError("Mouse passthrough requires a borderless window");
+    }
+    const bool previous = RachelSDL_WindowMousePassthrough(window);
+    if (previous == enabled) return true;
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    if (!SDL_SetBooleanProperty(props, RACHEL_SDL_MOUSE_PASSTHROUGH, enabled)) return false;
+    bool result = false;
+#ifdef SDL_VIDEO_DRIVER_WINDOWS
+    if (SDL_strcmp(_this->name, "windows") == 0) result = WIN_RachelMousePassthrough(_this, window, enabled);
+    else
+#endif
+#ifdef SDL_VIDEO_DRIVER_COCOA
+    if (SDL_strcmp(_this->name, "cocoa") == 0) result = Cocoa_RachelMousePassthrough(_this, window, enabled);
+    else
+#endif
+#ifdef SDL_VIDEO_DRIVER_X11
+    if (SDL_strcmp(_this->name, "x11") == 0) result = X11_RachelMousePassthrough(_this, window, enabled);
+    else
+#endif
+#ifdef SDL_VIDEO_DRIVER_WAYLAND
+    if (SDL_strcmp(_this->name, "wayland") == 0) result = Wayland_RachelMousePassthrough(_this, window, enabled);
+    else
+#endif
+    result = SDL_Unsupported();
+    if (!result) SDL_SetBooleanProperty(props, RACHEL_SDL_MOUSE_PASSTHROUGH, previous);
+    return result;
+}
