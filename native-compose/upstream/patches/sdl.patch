+/* Rachel extension: whole-window mouse passthrough. */
+#include "SDL_internal.h"
+#ifdef SDL_VIDEO_DRIVER_X11
+#include "SDL_x11video.h"
+#include "SDL_x11shape.h"
+
+bool X11_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled);
+bool X11_RachelMousePassthrough(SDL_VideoDevice *_this, SDL_Window *window, bool enabled)
+{
+#ifdef SDL_VIDEO_DRIVER_X11_XSHAPE
+    SDL_WindowData *data = window->internal;
+    Display *display = data->videodata->display;
+    int major = 0, minor = 0;
+    if (!SDL_X11_HAVE_XSHAPE || !X11_XShapeQueryVersion(display, &major, &minor) || major < 1 || (major == 1 && minor < 1)) {
+        return SDL_SetError("Mouse passthrough requires X11 SHAPE 1.1");
+    }
+    if (enabled) {
+        Region region = X11_XCreateRegion();
+        if (!region) return SDL_OutOfMemory();
+        X11_XShapeCombineRegion(display, data->xwindow, ShapeInput, 0, 0, region, ShapeSet);
+        X11_XDestroyRegion(region);
+    } else {
+        SDL_Surface *shape = (SDL_Surface *)SDL_GetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_SHAPE_POINTER, NULL);
+        if (!X11_UpdateWindowShape(_this, window, shape)) return false;
+    }
+    X11_XFlush(display);
+    return true;
+#else
+    return SDL_Unsupported();
+#endif
+}
+#endif
