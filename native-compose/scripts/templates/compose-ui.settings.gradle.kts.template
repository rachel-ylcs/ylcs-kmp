import groovy.json.JsonSlurper
import love.yinlin.nativebridge.NativeBridgeSourcesExtension
import java.security.MessageDigest

pluginManagement {
    includeBuild("../../../../../build-logic")
    repositories {
        mavenCentral()
        google()
        gradlePluginPortal()
    }
}

plugins {
    id("love.yinlin.native-bridge.settings")
}

dependencyResolutionManagement {
    repositories {
        mavenCentral()
        google()
    }
    versionCatalogs {
        create("libs") { from(files("../../../../../libs.versions.toml")) }
    }
}

rootProject.name = "native-compose-ui"
val repositoryDirectory = settingsDir.resolve("../../../../..").canonicalFile
val nativeDirectory = repositoryDirectory.resolve("native-compose")
val sourceLock = JsonSlurper().parse(nativeDirectory.resolve("upstream/compose.json")) as Map<*, *>
val modules = sourceLock["modules"] as Map<*, *>
val ciStage = providers.gradleProperty("native.ui.ci").getOrElse("false").toBooleanStrict()
val selectedModules = if (ciStage) (sourceLock["ciModules"] as List<*>).map { it as String }.toSet()
else modules.keys.map { it as String }.toSet()

__PROJECTS__

// Root maintainer mode prepares Skiko first. A standalone UI baseline needs no Skiko checkout.
val skikoState = nativeDirectory.resolve("vendor/skiko/state.json")
val requiresSkiko = selectedModules.any { (modules[it] as Map<*, *>)["requiresSkiko"] == true }
if (requiresSkiko) {
    check(skikoState.isFile) { "Prepare Skiko from the root native.compose=true build before building UI graphics; the CI baseline uses -Pnative.ui.ci=true" }
    val state = JsonSlurper().parse(skikoState) as Map<*, *>
    val catalogHash = MessageDigest.getInstance("SHA-256").digest(repositoryDirectory.resolve("libs.versions.toml").readBytes()).joinToString("") { "%02x".format(it) }
    check(state["catalogSha256"] == catalogHash) { "Skiko source state is stale; prepare it from the root maintainer build before building UI graphics" }
    val skikoDirectory = nativeDirectory.resolve(state["build"] as String).canonicalFile
    require(skikoDirectory == nativeDirectory.resolve("vendor/skiko/workspace/skiko").canonicalFile) { "Invalid Skiko source directory" }
    val lock = JsonSlurper().parse(nativeDirectory.resolve("upstream/lock.json")) as Map<*, *>
    gradle.extensions.extraProperties.set("love.yinlin.nativeCompose.maintainer", true)
    gradle.extensions.extraProperties.set("love.yinlin.nativeCompose.root", nativeDirectory)
    val versions = state["versions"] as Map<*, *>
    for (rule in listOf("skiko-core", "skiko-skottie")) {
        gradle.extensions.extraProperties.set("love.yinlin.nativeBridge.version.$rule", versions["skiko"] as String)
    }
    extensions.getByType<NativeBridgeSourcesExtension>().include(skikoDirectory, "skiko", mapOf(
        "skiko-core" to ("${lock["group"]}:skiko" to ":"),
        "skiko-skottie" to ("${lock["group"]}:skiko-skottie" to ":skiko-skottie"),
    ), mapOf(
        "skiko-core" to nativeDirectory.resolve("adaptation/org.jetbrains.skiko_skiko"),
        "skiko-skottie" to nativeDirectory.resolve("adaptation/org.jetbrains.skiko_skiko-skottie"),
    ))
}
