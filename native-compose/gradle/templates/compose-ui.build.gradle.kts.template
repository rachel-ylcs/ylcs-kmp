import groovy.json.JsonSlurper
import org.gradle.api.artifacts.VersionCatalogsExtension
import org.gradle.api.publish.PublishingExtension
import org.gradle.api.publish.maven.MavenPublication
import org.gradle.api.publish.maven.tasks.PublishToMavenRepository
import org.gradle.jvm.tasks.Jar
import org.jetbrains.kotlin.gradle.dsl.KotlinMultiplatformExtension
import org.jetbrains.kotlin.gradle.plugin.mpp.KotlinNativeTarget
import org.jetbrains.kotlin.gradle.plugin.mpp.TestExecutable
import org.jetbrains.kotlin.konan.target.Family
import org.jetbrains.kotlin.konan.target.HostManager

plugins {
    // Native Bridge Settings supplies KGP from the root build-logic version catalog.
    id("org.jetbrains.kotlin.multiplatform") apply false
    alias(libs.plugins.composeCompiler) apply false
}

val repositoryDirectory = rootDir.resolve("../../../../..").canonicalFile
val nativeDirectory = repositoryDirectory.resolve("native-compose")
val sourceLock = JsonSlurper().parse(nativeDirectory.resolve("upstream/compose.json")) as Map<*, *>
val modules = sourceLock["modules"] as Map<*, *>
val composeVersion = extensions.getByType<VersionCatalogsExtension>().named("libs").findVersion("cmp").get().requiredVersion
val hostTarget = when (HostManager.host.name) {
    "mingw_x64" -> "windows"
    "linux_x64" -> "linux"
    "macos_arm64" -> "macos"
    else -> error("Unsupported Native UI build host: ${HostManager.host}")
}
layout.buildDirectory.set(nativeDirectory.resolve("vendor/build/compose-ui/root"))

subprojects {
    // KLIB module identities follow upstream; Maven publication coordinates remain independent.
    val module = modules[name] as Map<*, *>
    val upstreamGroup = (module["upstreamGroup"] ?: "org.jetbrains.compose.${module["family"] ?: "ui"}") as String
    group = upstreamGroup
    version = module["version"] ?: composeVersion
    layout.buildDirectory.set(nativeDirectory.resolve("vendor/build/compose-ui/$name"))

    plugins.withId("org.jetbrains.kotlin.multiplatform") {
        extensions.configure<KotlinMultiplatformExtension> {
            jvmToolchain(__JAVA_VERSION__)
            compilerOptions {
                freeCompilerArgs.addAll("-Xexpect-actual-classes", "-Xcollection-literals")
                optIn.add("androidx.compose.ui.ExperimentalComposeUiApi")
            }
            mingwX64("windows")
            linuxX64("linux")
            macosArm64("macos")
            targets.withType<KotlinNativeTarget>().configureEach {
                // Keep assertions and Native caches; CI does not need Apple's DWARF debug map.
                if (konanTarget.family == Family.OSX && providers.environmentVariable("GITHUB_ACTIONS").orNull == "true") {
                    binaries.withType<TestExecutable>().configureEach { linkerOpts("-S") }
                }
                val nativeArtifact = "${project.name}-${konanTarget.name.replace("_", "")}"
                // KGP assigns its default artifactId after PublicationContainer callbacks.
                // This target hook runs afterwards, before dependency coordinates are exported.
                mavenPublication { artifactId = nativeArtifact }
                compilations.getByName("main").compileTaskProvider.configure {
                    compilerOptions.moduleName.set("$upstreamGroup:${project.name}")
                }
            }
            sourceSets {
                commonTest.dependencies { implementation(kotlin("test")) }
                val module = modules[project.name] as? Map<*, *>
                val selectedSources = module?.get("sourceSets") as? Map<*, *>
                val sharedMain = if (selectedSources?.containsKey("skikoMain") == true) create("skikoMain") { dependsOn(commonMain.get()) }
                else commonMain.get()
                val nativeMain = create("nativeMain") { dependsOn(sharedMain) }
                val nativeTest = create("nativeTest") { dependsOn(commonTest.get()) }
                for (target in listOf("windows", "linux", "macos")) {
                    getByName("${target}Main").dependsOn(nativeMain)
                    getByName("${target}Test").dependsOn(nativeTest)
                }
                if (selectedSources != null) {
                    val adaptation = nativeDirectory.resolve("adaptation/${module["adaptation"] ?: "${upstreamGroup}_${project.name}"}")
                    val adaptationFragments = module["adaptationSourceSets"] as? Map<*, *> ?: emptyMap<String, String>()
                    configureEach {
                        val upstream = selectedSources[name] as? List<*> ?: emptyList<String>()
                        kotlin.setSrcDirs(upstream.map { project.file(it as String) })
                        // Preserve upstream metadata boundaries without extra maintained directories.
                        val physical = adaptationFragments[name] as? String ?: name
                        if (name !in adaptationFragments.values || name in adaptationFragments) kotlin.srcDir(adaptation.resolve("src/$physical/kotlin"))
                    }
                }
            }
        }
    }

    plugins.withId("maven-publish") {
        extensions.configure<PublishingExtension> {
            repositories {
                maven {
                    name = "NativeVerification"
                    url = uri(nativeDirectory.resolve("vendor/build/compose-ui/repository"))
                }
            }
            publications.withType<MavenPublication>().configureEach {
                groupId = (module["group"] ?: sourceLock["group"]) as String
                pom {
                    name.set("Rachel Native ${project.name}")
                    description.set("Native desktop adaptation of Compose ${project.name}; modified by Rachel")
                    url.set("https://github.com/rachel-ylcs/ylcs-kmp")
                    licenses {
                        license {
                            name.set("The Apache Software License, Version 2.0")
                            url.set("https://www.apache.org/licenses/LICENSE-2.0.txt")
                        }
                    }
                    scm { url.set(if (module["sourceRepository"] == "resources") "https://github.com/JetBrains/compose-multiplatform" else "https://github.com/JetBrains/compose-multiplatform-core") }
                }
            }
        }
        tasks.withType<PublishToMavenRepository>().configureEach {
            doFirst {
                check(repository.url.scheme == "file") { "Native UI remote Maven publishing is disabled" }
                check(publication.name in setOf("kotlinMultiplatform", hostTarget)) {
                    "Publish ${publication.name} on its matching Native host"
                }
                val target = project.extensions.getByType<KotlinMultiplatformExtension>().targets.findByName(publication.name) as? KotlinNativeTarget
                val expected = if (target == null) project.name else "${project.name}-${target.konanTarget.name.replace("_", "")}"
                check(publication.artifactId == expected) {
                    "Native UI publication ${publication.name} must use $expected, got ${publication.artifactId}"
                }
            }
        }
        tasks.withType<Jar>().matching { it.name.endsWith("SourcesJar") || it.name == "sourcesJar" }.configureEach {
            val sourceLicense = if (module["sourceRepository"] == "maven") project.file("LICENSE.txt")
            else if (module["sourceRepository"] == "resources") nativeDirectory.resolve("vendor/resources/workspace/LICENSE.txt")
            else rootDir.resolve("../LICENSE.txt")
            from(sourceLicense) { into("META-INF/licenses") }
            from(listOf(nativeDirectory.resolve("upstream/compose.json"), nativeDirectory.resolve("upstream/compose-origins.json"))) {
                into("META-INF/provenance")
            }
        }
    }
}

tasks.register("publishHostToVerificationRepository") {
    group = "publishing"
    for (module in modules.keys) {
        dependsOn(":$module:publishKotlinMultiplatformPublicationToNativeVerificationRepository")
        dependsOn(":$module:publish${hostTarget.replaceFirstChar(Char::uppercase)}PublicationToNativeVerificationRepository")
    }
}

tasks.register("publishAllHostToVerificationRepository") {
    group = "publishing"
    dependsOn("publishHostToVerificationRepository")
}
