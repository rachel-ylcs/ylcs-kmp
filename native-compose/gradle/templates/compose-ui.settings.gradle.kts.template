import groovy.json.JsonSlurper
import love.yinlin.nativebridge.NativeBridgeSourcesExtension
import java.security.MessageDigest

pluginManagement {
    includeBuild("__REPOSITORY__/build-logic")
    repositories {
        mavenCentral()
        google()
        gradlePluginPortal()
    }
}

plugins {
    id("love.yinlin.native-bridge.settings")
}

dependencyResolutionManagement {
    repositories {
        mavenCentral()
        google()
    }
    versionCatalogs {
        create("libs") { from(files("__REPOSITORY__/libs.versions.toml")) }
    }
}

rootProject.name = "native-compose-ui"
val repositoryDirectory = settingsDir.resolve("__REPOSITORY__").canonicalFile
val nativeDirectory = repositoryDirectory.resolve("native-compose")
val generation = settingsDir.resolve("../../..").canonicalFile
val ready = JsonSlurper().parse(generation.resolve("ready.json")) as Map<*, *>
val catalogHash = MessageDigest.getInstance("SHA-256").digest(repositoryDirectory.resolve("libs.versions.toml").readBytes()).joinToString("") { "%02x".format(it) }
check(ready["catalogSha256"] == catalogHash) { "Prepared Compose sources are stale; use the root build to synchronize sources" }
gradle.extensions.extraProperties.set("love.yinlin.nativeCompose.generation", generation)
val sourceMetadata = JsonSlurper().parse(generation.resolve("metadata/compose.json")) as Map<*, *>
val modules = sourceMetadata["modules"] as Map<*, *>
val selectedModules = modules.keys.map { it as String }.toSet()

__PROJECTS__

// Both maintainer mode and the graphics/text CI stage prepare this same Skiko source build first.
val requiresSkiko = selectedModules.any { (modules[it] as Map<*, *>)["requiresSkiko"] == true }
if (requiresSkiko) {
    val skikoDirectory = generation.resolve("skiko/workspace/skiko")
    val lock = JsonSlurper().parse(generation.resolve("metadata/skiko.json")) as Map<*, *>
    gradle.extensions.extraProperties.set("love.yinlin.nativeCompose.maintainer", true)
    for (rule in listOf("skiko-core", "skiko-skottie")) {
        gradle.extensions.extraProperties.set("love.yinlin.nativeBridge.version.$rule", lock["version"] as String)
    }
    extensions.getByType<NativeBridgeSourcesExtension>().include(skikoDirectory, "skiko", mapOf(
        "skiko-core" to ("${lock["group"]}:skiko" to ":"),
        "skiko-skottie" to ("${lock["group"]}:skiko-skottie" to ":skiko-skottie"),
    ), mapOf(
        "skiko-core" to nativeDirectory.resolve("adaptation/org.jetbrains.skiko_skiko"),
        "skiko-skottie" to nativeDirectory.resolve("adaptation/org.jetbrains.skiko_skiko-skottie"),
    ))
}
