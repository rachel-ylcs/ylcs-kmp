headers = SDL3/SDL.h SDL3/SDL_vulkan.h SDL3/SDL_metal.h SDL3/SDL_racheldrop.h
headerFilter = SDL3/**
package = org.jetbrains.skiko.internal.sdl
---
// Keep SDL's private object layouts opaque while exposing handles that the IDE can resolve.
// Kotlin's exported cnames forward declarations currently have IDE indexing limitations.
static inline bool RachelSDL_IsFile(const char *path) {
    SDL_PathInfo info;
    return SDL_GetPathInfo(path, &info) && info.type == SDL_PATHTYPE_FILE;
}
static inline void *RachelSDL_OpenFile(const char *path, const char *mode) {
    return SDL_IOFromFile(path, mode);
}
static inline Sint64 RachelSDL_GetFileSize(void *stream) {
    return SDL_GetIOSize((SDL_IOStream *)stream);
}
static inline Sint64 RachelSDL_SeekFile(void *stream, Sint64 offset) {
    return SDL_SeekIO((SDL_IOStream *)stream, offset, SDL_IO_SEEK_SET);
}
static inline size_t RachelSDL_ReadFile(void *stream, void *destination, size_t size) {
    return SDL_ReadIO((SDL_IOStream *)stream, destination, size);
}
static inline bool RachelSDL_CloseFile(void *stream) {
    return SDL_CloseIO((SDL_IOStream *)stream);
}
static inline void *RachelSDL_CreateWindow(const char *title, int width, int height, SDL_WindowFlags flags) {
    return SDL_CreateWindow(title, width, height, flags);
}
static inline void RachelSDL_DestroyWindow(void *window) {
    SDL_DestroyWindow((SDL_Window *)window);
}
static inline bool RachelSDL_GetWindowSizeInPixels(void *window, int *width, int *height) {
    return SDL_GetWindowSizeInPixels((SDL_Window *)window, width, height);
}
static inline bool RachelSDL_SetWindowSize(void *window, int width, int height) {
    return SDL_SetWindowSize((SDL_Window *)window, width, height);
}
static inline bool RachelSDL_GetWindowSize(void *window, int *width, int *height) {
    return SDL_GetWindowSize((SDL_Window *)window, width, height);
}
static inline bool RachelSDL_GetWindowPosition(void *window, int *x, int *y) {
    return SDL_GetWindowPosition((SDL_Window *)window, x, y);
}
static inline bool RachelSDL_SetWindowPosition(void *window, int x, int y) {
    return SDL_SetWindowPosition((SDL_Window *)window, x, y);
}
static inline bool RachelSDL_GetWindowDisplayBounds(void *window, SDL_Rect *bounds) {
    SDL_DisplayID display = SDL_GetDisplayForWindow((SDL_Window *)window);
    if (!display) display = SDL_GetPrimaryDisplay();
    return SDL_GetDisplayUsableBounds(display, bounds);
}
static inline SDL_PropertiesID RachelSDL_GetWindowProperties(void *window) {
    return SDL_GetWindowProperties((SDL_Window *)window);
}
static inline const char *RachelSDL_GetWindowTitle(void *window) {
    return SDL_GetWindowTitle((SDL_Window *)window);
}
static inline SDL_WindowFlags RachelSDL_GetWindowFlags(void *window) {
    return SDL_GetWindowFlags((SDL_Window *)window);
}
static inline bool RachelSDL_SetWindowTitle(void *window, const char *title) {
    return SDL_SetWindowTitle((SDL_Window *)window, title);
}
static inline bool RachelSDL_SetWindowMinimumSize(void *window, int width, int height) {
    return SDL_SetWindowMinimumSize((SDL_Window *)window, width, height);
}
static inline bool RachelSDL_SetWindowUndecorated(void *window, bool undecorated) {
    return SDL_SetWindowBordered((SDL_Window *)window, !undecorated);
}
// SDL copies the pixels before returning. Neither the borrowed array nor the surface is retained.
static inline bool RachelSDL_SetWindowIcon(void *window, int width, int height, void *pixels) {
    SDL_Surface *surface = SDL_CreateSurfaceFrom(width, height, SDL_PIXELFORMAT_ARGB8888, pixels, width * 4);
    if (!surface) return false;
    const bool success = SDL_SetWindowIcon((SDL_Window *)window, surface);
    SDL_DestroySurface(surface);
    return success;
}
static inline void *RachelSDL_CreateTray(const char *tooltip) {
    return SDL_CreateTray(NULL, tooltip);
}
static inline void RachelSDL_DestroyTray(void *tray) {
    SDL_DestroyTray((SDL_Tray *)tray);
}
static inline bool RachelSDL_SetTrayIcon(void *tray, int width, int height, void *pixels) {
    SDL_Surface *surface = SDL_CreateSurfaceFrom(width, height, SDL_PIXELFORMAT_ARGB8888, pixels, width * 4);
    if (!surface) return false;
    SDL_SetTrayIcon((SDL_Tray *)tray, surface);
    SDL_DestroySurface(surface);
    return true;
}
static inline void RachelSDL_SetTrayTooltip(void *tray, const char *tooltip) {
    SDL_SetTrayTooltip((SDL_Tray *)tray, tooltip);
}
typedef bool (*RachelSDL_DragAreaCallback)(void *userdata, float x, float y);
typedef struct RachelSDL_WindowHitTest {
    RachelSDL_DragAreaCallback callback;
    void *userdata;
} RachelSDL_WindowHitTest;

static SDL_HitTestResult SDLCALL RachelSDL_HitTestWindow(SDL_Window *window, const SDL_Point *point, void *userdata) {
    const SDL_WindowFlags flags = SDL_GetWindowFlags(window);
    if (!(flags & SDL_WINDOW_BORDERLESS)) return SDL_HITTEST_NORMAL;
    float density = SDL_GetWindowPixelDensity(window);
    if (!(density > 0)) density = 1;
    if ((flags & SDL_WINDOW_RESIZABLE) && !(flags & (SDL_WINDOW_MAXIMIZED | SDL_WINDOW_FULLSCREEN))) {
        int width = 0, height = 0;
        SDL_GetWindowSize(window, &width, &height);
        float scale = SDL_GetWindowDisplayScale(window);
        if (!(scale > 0)) scale = density;
        const float edge = 6 * scale / density;
        const bool left = point->x >= 0 && point->x < edge;
        const bool right = point->x < width && point->x >= width - edge;
        const bool top = point->y >= 0 && point->y < edge;
        const bool bottom = point->y < height && point->y >= height - edge;
        if (top) return left ? SDL_HITTEST_RESIZE_TOPLEFT : right ? SDL_HITTEST_RESIZE_TOPRIGHT : SDL_HITTEST_RESIZE_TOP;
        if (bottom) return left ? SDL_HITTEST_RESIZE_BOTTOMLEFT : right ? SDL_HITTEST_RESIZE_BOTTOMRIGHT : SDL_HITTEST_RESIZE_BOTTOM;
        if (left) return SDL_HITTEST_RESIZE_LEFT;
        if (right) return SDL_HITTEST_RESIZE_RIGHT;
    }
    const RachelSDL_WindowHitTest *test = (const RachelSDL_WindowHitTest *)userdata;
    return test->callback(test->userdata, point->x * density, point->y * density) ? SDL_HITTEST_DRAGGABLE : SDL_HITTEST_NORMAL;
}
static inline void *RachelSDL_CreateWindowHitTest(void *window, RachelSDL_DragAreaCallback callback, void *userdata) {
    RachelSDL_WindowHitTest *test = (RachelSDL_WindowHitTest *)SDL_malloc(sizeof(RachelSDL_WindowHitTest));
    if (!test) return NULL;
    test->callback = callback;
    test->userdata = userdata;
    if (!SDL_SetWindowHitTest((SDL_Window *)window, RachelSDL_HitTestWindow, test)) {
        SDL_free(test);
        return NULL;
    }
    return test;
}
static inline void RachelSDL_DestroyWindowHitTest(void *window, void *test) {
    SDL_SetWindowHitTest((SDL_Window *)window, NULL, NULL);
    SDL_free(test);
}
static inline bool RachelSDL_SetWindowVisible(void *window, bool visible) {
    return visible ? SDL_ShowWindow((SDL_Window *)window) : SDL_HideWindow((SDL_Window *)window);
}
static inline bool RachelSDL_SetWindowAlwaysOnTop(void *window, bool alwaysOnTop) {
    return SDL_SetWindowAlwaysOnTop((SDL_Window *)window, alwaysOnTop);
}
static inline bool RachelSDL_MinimizeWindow(void *window) {
    return SDL_MinimizeWindow((SDL_Window *)window);
}
static inline bool RachelSDL_MaximizeWindow(void *window) {
    return SDL_MaximizeWindow((SDL_Window *)window);
}
static inline bool RachelSDL_RestoreWindow(void *window) {
    return SDL_RestoreWindow((SDL_Window *)window);
}
static inline float RachelSDL_GetWindowDisplayScale(void *window) {
    return SDL_GetWindowDisplayScale((SDL_Window *)window);
}
static inline float RachelSDL_GetWindowPixelDensity(void *window) {
    return SDL_GetWindowPixelDensity((SDL_Window *)window);
}
static inline bool RachelSDL_StartTextInput(void *window) {
    return SDL_StartTextInput((SDL_Window *)window);
}
static inline bool RachelSDL_StopTextInput(void *window) {
    return SDL_StopTextInput((SDL_Window *)window);
}
static inline bool RachelSDL_SetTextInputArea(void *window, int x, int y, int width, int height) {
    SDL_Rect area = {x, y, width, height};
    return SDL_SetTextInputArea((SDL_Window *)window, &area, 0);
}
static inline void *RachelSDL_CreateCursor(SDL_SystemCursor cursor) {
    return SDL_CreateSystemCursor(cursor);
}
static inline bool RachelSDL_SetCursor(void *cursor) {
    return SDL_SetCursor((SDL_Cursor *)cursor);
}
static inline void RachelSDL_DestroyCursor(void *cursor) {
    SDL_DestroyCursor((SDL_Cursor *)cursor);
}
static inline void RachelSDL_WakeEventLoop(Uint32 type) {
    SDL_Event event;
    SDL_zero(event);
    event.type = type;
    SDL_PushEvent(&event);
}
static inline bool RachelSDL_IsFullscreen(void *window) {
    return (SDL_GetWindowFlags((SDL_Window *)window) & SDL_WINDOW_FULLSCREEN) != 0;
}
static inline bool RachelSDL_IsWindowShowing(void *window) {
    const SDL_WindowFlags flags = SDL_GetWindowFlags((SDL_Window *)window);
    return (flags & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED)) == 0;
}
static inline bool RachelSDL_SetFullscreen(void *window, bool fullscreen) {
    return SDL_SetWindowFullscreen((SDL_Window *)window, fullscreen);
}
static inline void RachelSDL_RequestRender(void *window) {
    SDL_Event event;
    SDL_zero(event);
    event.type = SDL_EVENT_WINDOW_EXPOSED;
    event.window.windowID = SDL_GetWindowID((SDL_Window *)window);
    SDL_PushEvent(&event);
}
static inline void *RachelSDL_GetWin32Window(void *window) {
    return SDL_GetPointerProperty(SDL_GetWindowProperties((SDL_Window *)window), SDL_PROP_WINDOW_WIN32_HWND_POINTER, NULL);
}
static inline void *RachelSDL_CreateMetalView(void *window) {
    return SDL_Metal_CreateView((SDL_Window *)window);
}
static inline void *RachelSDL_GetMetalLayer(void *view) {
    return SDL_Metal_GetLayer((SDL_MetalView)view);
}
static inline void RachelSDL_DestroyMetalView(void *view) {
    SDL_Metal_DestroyView((SDL_MetalView)view);
}
// Skiko owns and destroys the returned VkSurfaceKHR before SDL destroys the window.
static void *RachelSDL_CreateVulkanSurface(void *window, void *instance) {
    VkSurfaceKHR surface = (VkSurfaceKHR)0;
    if (!SDL_Vulkan_CreateSurface((SDL_Window *)window, (VkInstance)instance, NULL, &surface)) return NULL;
    return (void *)surface;
}
static inline void *RachelSDL_VulkanSurfaceFactory(void) {
    return (void *)&RachelSDL_CreateVulkanSurface;
}
static inline void *RachelSDL_CreateRenderer(void *window, const char *name) {
    return SDL_CreateRenderer((SDL_Window *)window, name);
}
static inline void RachelSDL_DestroyRenderer(void *renderer) {
    SDL_DestroyRenderer((SDL_Renderer *)renderer);
}
static inline SDL_Texture *RachelSDL_CreateTexture(void *renderer, SDL_PixelFormat format, SDL_TextureAccess access, int width, int height) {
    return SDL_CreateTexture((SDL_Renderer *)renderer, format, access, width, height);
}
static inline bool RachelSDL_RenderClear(void *renderer) {
    return SDL_SetRenderDrawColor((SDL_Renderer *)renderer, 0, 0, 0, 0) && SDL_RenderClear((SDL_Renderer *)renderer);
}
static inline bool RachelSDL_RenderTexture(void *renderer, SDL_Texture *texture, const SDL_FRect *source, const SDL_FRect *destination) {
    return SDL_RenderTexture((SDL_Renderer *)renderer, texture, source, destination);
}
static inline bool RachelSDL_RenderPresent(void *renderer) {
    return SDL_RenderPresent((SDL_Renderer *)renderer);
}
