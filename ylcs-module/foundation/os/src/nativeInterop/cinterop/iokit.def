headers = CoreFoundation/CoreFoundation.h IOKit/ps/IOPowerSources.h
headerFilter = CoreFoundation/** IOKit/ps/**
package = love.yinlin.foundation.os.iokit
linkerOpts = -framework IOKit -framework CoreFoundation
---
static inline Boolean RachelIOKitCFStringEqual(CFStringRef lhs, CFStringRef rhs) {
    return CFEqual(lhs, rhs);
}
